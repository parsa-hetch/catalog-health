// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScanStatus {
  QUEUED
  FETCHING
  ANALYZING
  CALCULATING
  PERSISTING
  COMPLETED
  FAILED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum IssueCategory {
  PRODUCT_INFORMATION
  MEDIA
  SEO
  INVENTORY
  VARIANTS
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Scan {
  id           String     @id @default(uuid())
  shop         String
  status       ScanStatus @default(QUEUED)
  productCount Int        @default(0)
  healthScore  Int?       // Nullable until CALCULATING step finishes
  errorMessage String?    // Populated if status becomes FAILED

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  issues Issue[]

  @@index([shop, createdAt])
  @@index([shop, status])
}

model Issue {
  id            String        @id @default(uuid())
  scanId        String
  ruleId        String        // e.g. "missing_title", "missing_description"
  category      IssueCategory @default(PRODUCT_INFORMATION)
  severity      Severity      @default(MEDIUM)
  title         String
  description   String
  whyItMatters  String
  howToFix      String
  affectedCount Int           @default(0)
  createdAt     DateTime      @default(now())

  scan      Scan            @relation(fields: [scanId], references: [id], onDelete: Cascade)
  instances IssueInstance[]

  @@unique([scanId, ruleId]) // Each scan has at most one aggregated Issue record per rule
  @@index([scanId])
  @@index([ruleId])
  @@index([severity])
}

model IssueInstance {
  id           String   @id @default(uuid())
  issueId      String
  productId    String
  productTitle String
  variantId    String?
  metadata     Json?    // Flexible payload for rule-specific debug context
  createdAt    DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([productId])
}